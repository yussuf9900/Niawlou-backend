# ==============================================================================
# NIAWLOU BACKEND — TEMPLATE ENVIRONNEMENT DE PRODUCTION (RENDER & NEON)
# ==============================================================================

# Serveur & Runtime
NODE_ENV=production
PORT=10000
API_PREFIX=/api/v1

# Sécurité & Chiffrement JWT (Générez une clé aléatoire forte via: openssl rand -hex 32)
JWT_SECRET=remplacer_par_un_secret_jwt_aleatoire_fort_de_production_256bit
JWT_EXPIRES_IN=7d

# Base de données PostgreSQL infogérée (Neon Serverless Connection Pooling)
DATABASE_URL="postgresql://utilisateur:mot_de_passe@ep-xxxx-pooler.c-6.region.aws.neon.tech/neondb?sslmode=require"

# Passerelle de Paiement Orange Money (API Production Sonatel)
ORANGE_MONEY_API_URL=https://api.orange.com/orange-money-webpay/sn/v1
ORANGE_MONEY_MERCHANT_KEY=votre_cle_marchand_orange_money_production
ORANGE_MONEY_WEBHOOK_SECRET=votre_secret_signature_webhook_production
ORANGE_MONEY_NOTIF_URL=https://votre-app-service.onrender.com/api/v1/payments/webhook

# Règles Métier NIAWLOU
DEFAULT_ADVANCE_PERCENTAGE=40
MAX_DISPUTE_HOURS=48
DEFAULT_DELIVERY_FEE=1500
